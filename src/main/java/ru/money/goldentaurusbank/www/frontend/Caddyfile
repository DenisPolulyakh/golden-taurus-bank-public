# Системный Caddy — доверенный прокси: его X-Forwarded-Proto: https нужно
# передать бэкенду как есть, иначе он подставит свою схему (http)
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$APP_DOMAIN:localhost} {
	encode gzip

	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy app:8081
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
