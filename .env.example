# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).
# Сохраняйте .env с переводами строк LF, без пробелов в конце строк:
#   sed -i 's/\r$//; s/[[:space:]]*$//' .env

# --- База данных ---
# Пароль пользователя postgres (taurus). Придумайте свой.
DB_USERNAME=taurus
DB_PASSWORD=change_me_db_password
DB_SCHEMA=taurus

# --- JWT ---
# Секрет для подписи токенов. ОБЯЗАТЕЛЬНО задайте свой, минимум 32 символа.
# Сгенерировать:  openssl rand -base64 48
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48

# --- Домен ---
# На это имя Caddy выпускает сертификат Let's Encrypt. Домен должен
# резолвиться в IP этого сервера ещё до первого запуска.
APP_DOMAIN=example.com

# --- Внешний адрес приложения ---
# Подставляется в ссылки писем (подтверждение почты, сброс пароля).
FRONTEND_URL=https://example.com

# --- Куки ---
# true когда приложение работает по HTTPS.
COOKIE_SECURE=true

# --- Почта (необязательно) ---
# Если email-уведомления не нужны — оставьте пустыми.
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_PROTOCOL=smtps
MAIL_USERNAME=
MAIL_PASSWORD=


SERVER_PORT=8081
